# Trading 212 — read-only API key, generated in the app under Settings → API.
# Copy this file to .env (which is gitignored) and fill in the key.
T212_API_KEY=
# Only set if your key was issued as a key/secret pair; leave blank for a single token.
T212_API_SECRET=
# live | demo
T212_ENV=live
# Seconds to cache the Trading 212 response for. Keep this generous — their API is rate limited.
T212_CACHE_TTL=300
